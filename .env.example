# Copy to `.env` and fill with your Supabase project values (Project Settings → API).
# Anon / publishable key is used as-is for Storage REST (eyJ… or sb_publishable_…).
# Run `supabase_schema.sql` in the SQL Editor for profiles/videos/battles + buckets.
# Public buckets: bawaal-videos, avatars (legacy uploads still use bawaalvideos).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Agora RTC (live 1v1 / BATTLE BAWAAL). Requires a development build — not Expo Go.
# App ID from https://console.agora.io/
# Leave EXPO_PUBLIC_AGORA_TOKEN empty only if App Certificate is disabled (dev/testing).
# Channel names are built as arena-1v1-<battleId> via src/config/agora.ts
EXPO_PUBLIC_AGORA_APP_ID=
EXPO_PUBLIC_AGORA_TOKEN=
