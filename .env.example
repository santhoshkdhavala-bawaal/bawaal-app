# Copy to `.env` and fill with your Supabase project values (Project Settings → API).
# EXPO_PUBLIC_SUPABASE_ANON_KEY must be the classic JWT anon key (three dot-separated
# segments starting with eyJ...). Short/publishable keys cause "Invalid Compact JWS"
# and the app will fall back to local clip preview until a valid JWT is set.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_PAYLOAD.YOUR_SIGNATURE
