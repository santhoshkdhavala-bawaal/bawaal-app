{
  "expo": {
    "name": "BAWAAL",
    "slug": "bawaal-mobile-v2",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash_v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070A"
    },
    "scheme": "bawaal",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bawaal.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow BAWAAL to access your camera to record battle responses.",
        "NSMicrophoneUsageDescription": "Allow BAWAAL to access your microphone to record battle audio."
      }
    },
    "android": {
      "package": "com.bawaal.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#05070A"
      },
      "splash": {
        "image": "./assets/splash_v2.png",
        "resizeMode": "contain",
        "backgroundColor": "#05070A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BAWAAL to access your camera to record battle responses.",
          "microphonePermission": "Allow BAWAAL to access your microphone to record battle audio.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash_v2.png",
          "backgroundColor": "#05070A",
          "resizeMode": "contain",
          "imageWidth": 280
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "a73d9071-005c-46b9-bb23-f52ef215941a"
      }
    },
    "owner": "bawaal"
  }
}
