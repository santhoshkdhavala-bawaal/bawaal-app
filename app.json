{
  "expo": {
    "name": "BAWAAL",
    "slug": "bawaal-mobile-v2",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash_v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#08120F"
    },
    "scheme": "bawaal",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bawaal.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow BAWAAL to access your camera for live battle streaming and responses.",
        "NSMicrophoneUsageDescription": "Allow BAWAAL to access your microphone for live battle audio and responses."
      }
    },
    "android": {
      "package": "com.bawaal.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#08120F"
      },
      "splash": {
        "image": "./assets/splash_v2.png",
        "resizeMode": "contain",
        "backgroundColor": "#08120F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BAWAAL to access your camera for live battle streaming and responses.",
          "microphonePermission": "Allow BAWAAL to access your microphone for live battle audio and responses.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash_v2.png",
          "backgroundColor": "#08120F",
          "resizeMode": "contain",
          "imageWidth": 280
        }
      ],
      "expo-video",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "a73d9071-005c-46b9-bb23-f52ef215941a"
      }
    },
    "owner": "bawaal"
  }
}
